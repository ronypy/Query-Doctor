# LLM
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=PutYourOwnKey

# Database (Docker Postgres on 5433)
DATABASE_URL=postgresql://qd_agent:qd_agent@localhost:5433/tpch
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tpch

# Agent behaviour
IMPROVEMENT_THRESHOLD=0.30
MAX_ITERATIONS=3
STATEMENT_TIMEOUT_MS=30000
DEMO_MODE=0

# Real validation (local demo DB only): real index in a rolled-back transaction
ENABLE_REAL_VALIDATION=1
REAL_VALIDATION_RUNS=3

# Savings model assumptions (only used with real-validation measurements)
# CALLS_PER_DAY=10000
VCPU_HOUR_PRICE_USD=0.04
STORAGE_GB_MONTH_USD=0.10
